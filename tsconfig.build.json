{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Only the build emits, and only src/ goes in the package. The base config
    // also covers test/, scripts/ and vitest.config.ts, so rootDir lives here.
    "rootDir": "src",
    // The package doesn't ship src/, so maps would point at missing files.
    "sourceMap": false,
    "declarationMap": false,
    // Members marked @internal (TikTokLiveConnection._terminateSocket, for
    // `yarn smoke --drop-after`) stay in the JavaScript but out of the types.
    "stripInternal": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
